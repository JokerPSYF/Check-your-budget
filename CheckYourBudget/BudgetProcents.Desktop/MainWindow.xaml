<Window x:Class="BudgetProcents.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BudgetProcents.Desktop.ViewModels"
        xmlns:core="clr-namespace:BudgetProcents.Core;assembly=BudgetProcents.Core"
        Title="Check your budget"
        Width="1040" Height="800" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Subsection" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <SolidColorBrush x:Key="DangerBrush" Color="#D13438" />
        <SolidColorBrush x:Key="WarningBrush" Color="#C77C02" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- The € after an amount box. -->
        <Style x:Key="CurrencyMark" TargetType="TextBlock">
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="{x:Static core:BudgetCalculator.Currency}" />
        </Style>

        <!-- Amount box. Invalid input turns red (the theme hides border colors while typing). -->
        <Style x:Key="AmountBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="130" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="ToolTip" Value="Enter a positive number, for example 12,50" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Item name: reads like a label, and shows the text box frame on hover and while editing.
             The negative margin lines its text up with the labels and headings above it. -->
        <Style x:Key="NameBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="-11,0,8,0" />
            <Setter Property="ToolTip" Value="Click to rename" />
        </Style>

        <!-- Small borderless button with an icon, used to remove a row. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Opacity" Value="0.7" />
            <!-- Keeps Tab moving between the boxes; the button is still reachable with the mouse and screen readers. -->
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <!-- One section of inputs: heading, its items, and a button to add another. -->
        <DataTemplate DataType="{x:Type vm:CategorySection}">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                <Button Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"
                        AutomationProperties.Name="{Binding AddLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE710;"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding AddLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- One input row: editable name, amount box with the currency, remove button. -->
        <DataTemplate DataType="{x:Type vm:ExpenseItem}">
            <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;"
                        Command="{Binding RemoveCommand}" ToolTip="Remove"
                        AutomationProperties.Name="{Binding DisplayName, StringFormat='Remove {0}'}" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource CurrencyMark}" />
                <TextBox DockPanel.Dock="Right" Style="{StaticResource AmountBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} amount'}" />
                <TextBox Style="{StaticResource NameBox}" Loaded="NameBox_Loaded"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Item name" />
            </DockPanel>
        </DataTemplate>

        <!-- One target of the chosen rule. -->
        <DataTemplate DataType="{x:Type vm:RuleRow}">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding PercentText}" />
                    <TextBlock>
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="·" />
                        <Run Text="{Binding AmountText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <ProgressBar x:Name="Bar" Height="8" Margin="0,6,0,4" Minimum="0"
                             Maximum="{Binding Maximum, Mode=OneWay}" Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Style="{StaticResource Small}" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RuleStatus.Over}">
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:RuleStatus.Under}">
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "By item": one section's items. Hidden while the section has none. -->
        <DataTemplate DataType="{x:Type vm:BreakdownSection}">
            <StackPanel x:Name="Root">
                <TextBlock Style="{StaticResource Subsection}" Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One item: name, amount, percent of the salary. -->
        <DataTemplate DataType="{x:Type vm:ItemRow}">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Right" Width="76" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding PercentText}" />
                <TextBlock DockPanel.Dock="Right" Width="120" TextAlignment="Right" Text="{Binding AmountText}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- INPUT -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24">
                <TextBlock Style="{StaticResource Title}" Text="Check your budget" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"
                           Text="Enter this month's salary and what you spent. Click a name to rename it, or add and remove items. Everything is saved as you type." />

                <DockPanel DataContext="{Binding Salary}" Margin="0,2">
                    <!-- Same width as a remove button, so the salary box lines up with the boxes below. -->
                    <Border DockPanel.Dock="Right" Width="32" Margin="4,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource CurrencyMark}" />
                    <TextBox DockPanel.Dock="Right" Style="{StaticResource AmountBox}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Monthly salary" />
                    <TextBlock Text="Monthly salary" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" />

                <Button Content="Clear amounts" Command="{Binding ClearCommand}"
                        HorizontalAlignment="Left" Margin="0,24,0,0" Padding="14,6" />
            </StackPanel>
        </ScrollViewer>

        <!-- RESULTS -->
        <Border Grid.Column="1" Background="#0D808080" BorderBrush="#33808080" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Spent" />
                            <TextBlock Style="{StaticResource Big}" Text="{Binding SpentText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Muted}" Text="Left over" />
                            <TextBlock Text="{Binding LeftOverText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Big}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverspent}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,18,0,10">
                        <ComboBox DockPanel.Dock="Right" MinWidth="150"
                                  ItemsSource="{Binding RuleOptions}" SelectedItem="{Binding Rule}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Budget rule" />
                        <TextBlock Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" Text="Rule" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Targets}" Focusable="False" />

                    <TextBlock Style="{StaticResource Section}" Text="By item" />
                    <ItemsControl ItemsSource="{Binding Breakdown}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
