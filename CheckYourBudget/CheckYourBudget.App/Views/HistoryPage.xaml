<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CheckYourBudget.App.ViewModels"
             x:Class="CheckYourBudget.App.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="History">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="760">
            <VerticalStackLayout>
                <Label Style="{StaticResource PageTitle}" Text="History" />
                <Label Style="{StaticResource Muted}" Text="{Binding RuleTitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                <Label Text="No months yet. Fill in a month on the Month screen and it shows up here." />
            </Border>

            <!-- The last 12 months: spending stacked by category, and a line for the income. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasMonths}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource SectionTitle}" Text="Spending by month" />
                        <Label Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding ChartTitle}" VerticalOptions="Center" />
                    </Grid>
                    <GraphicsView Drawable="{Binding Chart}" HeightRequest="180"
                                  SemanticProperties.Description="Bar chart of spending by month. The months are listed below." />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Legend}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LegendItem">
                                <HorizontalStackLayout Spacing="6" Margin="0,0,14,4">
                                    <Ellipse Fill="{Binding Color}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                    <Label Text="{Binding Name}" FontSize="13" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <HorizontalStackLayout Spacing="6">
                        <BoxView WidthRequest="14" HeightRequest="2" VerticalOptions="Center"
                                 Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        <Label Text="Income" FontSize="13" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasMonths}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionTitle}" Text="Export" />
                    <Label Style="{StaticResource Muted}"
                           Text="Every month in one Excel file: a summary sheet, then a sheet per month with all its items." />
                    <Button Text="Export to Excel" HorizontalOptions="Start" Command="{Binding ExportCommand}" />
                    <Label Style="{StaticResource Muted}" Text="{Binding ExportMessage}" IsVisible="{Binding HasExportMessage}" />
                    <Button Style="{StaticResource TextButton}" Text="Open the file" HorizontalOptions="Start"
                            Command="{Binding OpenExportCommand}" IsVisible="{Binding CanOpenExport}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Months}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRow">
                        <Border Style="{StaticResource Card}" Padding="16,12"
                                SemanticProperties.Description="{Binding Description}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Style="{StaticResource Strong}" FontSize="16" Text="{Binding Title}" />
                                    <Label Grid.Column="1" Style="{StaticResource Strong}" Text="{Binding LeftOverText}"
                                           TextColor="{Binding LeftOverColor}" />
                                    <Label Grid.Column="2" Style="{StaticResource Muted}" Text="›" FontSize="20" VerticalOptions="Center" />
                                </Grid>
                                <Label Style="{StaticResource Muted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding IncomeText}" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding SpentText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <GraphicsView Drawable="{Binding Bar}" HeightRequest="8" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Style="{StaticResource Muted}" FontSize="12" Text="{Binding SplitText}" />
                                    <Label Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Text="{Binding TargetsText}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
