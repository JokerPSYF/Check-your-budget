<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="CheckYourBudget.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CheckYourBudget.App.Views"
       Title="Check your budget">

    <TabBar>
        <ShellContent Title="Month" Icon="tab_month.png" Route="month" ContentTemplate="{DataTemplate views:MonthPage}" />
        <ShellContent Title="History" Icon="tab_history.png" Route="history" ContentTemplate="{DataTemplate views:HistoryPage}" />
        <ShellContent Title="Rule" Icon="tab_rule.png" Route="rule" ContentTemplate="{DataTemplate views:RulePage}" />
    </TabBar>

</Shell>
